# AgriLink Backend - Local Development .env
# Generated automatically - update with your real values

# ============================
# Server
# ============================
PORT=3000
NODE_ENV=development

# ============================
# PostgreSQL Database
# ============================
# Update these with your PostgreSQL credentials:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrilink
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrilink
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ============================
# JWT Authentication
# ============================
JWT_SECRET=agrilink_dev_jwt_secret_key_2024_local
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_SECRET=agrilink_dev_refresh_secret_key_2024_local
JWT_REFRESH_EXPIRES_IN=30d

# ============================
# OTP - Twilio (or mock for dev)
# ============================
# Set TWILIO_MOCK_OTP=true to skip Twilio and use a fixed OTP code
# This lets you develop WITHOUT a real Twilio account
TWILIO_MOCK_OTP=true
TWILIO_MOCK_OTP_CODE=123456
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================
# Razorpay (Payments)
# ============================
# Get from: https://dashboard.razorpay.com/app/keys
# For testing, use TEST mode keys (start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret

# ============================
# App Business Config
# ============================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
DELIVERY_CHARGE_DEFAULT=40
FREE_DELIVERY_ABOVE=500
GST_RATE=5

# ============================
# CORS
# ============================
CORS_ORIGIN=*
