# ==============================================================================
# AgriLink FastAPI Backend - Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values with your credentials.
# ==============================================================================

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_REF=your-project-ref

# Server Settings
PORT=8000
HOST=0.0.0.0
APP_ENV=development
DEBUG=True

# Corridor Logistics
PRIMARY_CORRIDOR=Mandya-Bengaluru Agro Corridor

# Free Google Gmail SMTP Email Verification (No paid API needed)
# 1. Turn ON 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=your_agrilink_sender@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# ==============================================================================
# TRI-SERVICE INTEGRATION (Microservice 2 & 3)
# Set these to connect AgriLink to Citizen (M2) and RTO Vehicle (M3).
# If not set, AgriLink still works standalone — all inter-service calls
# gracefully fall back to standalone mode on timeout or connection error.
# ==============================================================================

# Microservice 2 — Citizen Identity & Wallet (CIS)
# Local dev: http://localhost:8001/api/v1
# Deployed: https://your-citizen-service.onrender.com/api/v1
CITIZEN_SERVICE_URL=http://localhost:8001/api/v1

# Microservice 3 — RTO / Commercial Fleet (Microservice_Vehicle-)
# Local dev: http://localhost:8002/v1
# Deployed: https://your-rto-service.onrender.com/v1
RTO_SERVICE_URL=http://localhost:8002/v1

# Shared service-to-service secret (must match INTERNAL_SERVICE_SECRET in Microservice_Citizen)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_SECRET=insecure-internal-secret-for-marketplace-and-rto

# Inter-service call timeout in seconds (default 3.0)
INTER_SERVICE_TIMEOUT=3.0
