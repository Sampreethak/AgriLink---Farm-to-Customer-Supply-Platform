# ==============================================================================
# AgriLink FastAPI Backend - Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values with your credentials.
# ==============================================================================

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_REF=your-project-ref

# Server Settings
PORT=8000
HOST=0.0.0.0
APP_ENV=development
DEBUG=True

# Corridor Logistics
PRIMARY_CORRIDOR=Mandya-Bengaluru Agro Corridor

# Free Google Gmail SMTP Email Verification (No paid API needed)
# 1. Turn ON 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=your_agrilink_sender@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
