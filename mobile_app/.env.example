# ==============================================================================
# AgriLink Flutter Client - Environment Template (.env.example)
# Copy this file to .env and replace the placeholder values with your credentials.
# Run app using: flutter run --dart-define-from-file=.env
# ==============================================================================

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_REF=your-project-ref

# API Gateway Endpoints
API_BASE_URL=http://127.0.0.1:8000/api/v1
APP_ENV=development
